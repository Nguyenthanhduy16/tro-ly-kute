# ─── Discord (bắt buộc) ────────────────────────────────────────────────────
# Lấy ở https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ID server của bạn. Có giá trị này thì lệnh hiện ra ngay lập tức khi chạy `npm run deploy`.
# Để trống = đăng ký toàn cục, Discord cache tới ~1 tiếng mới thấy.
DISCORD_GUILD_ID=

# ─── AI review ─────────────────────────────────────────────────────────────
# Chọn nhà cung cấp: openrouter | gemini
# Để trống = tự chọn theo key nào đang có (ưu tiên OpenRouter).
AI_PROVIDER=openrouter

# OpenRouter — key ở https://openrouter.ai/keys
# Tên model và giá xem ở https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-pro-preview

# Gemini gọi thẳng — key ở https://aistudio.google.com/apikey
# Lưu ý: free tier của Google KHÔNG có quota cho các model "pro" (lỗi 429 limit: 0).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Tuỳ chỉnh hành vi ─────────────────────────────────────────────────────
TIMEZONE=Asia/Ho_Chi_Minh

# Báo cáo gửi trước giờ này tính cho NGÀY HÔM TRƯỚC (cú đêm làm tới 2h sáng vẫn tính là hôm qua).
DAY_ROLLOVER_HOUR=4

# weekdays = nghỉ T7/CN không mất streak · everyday = ngày nào cũng phải báo cáo
STREAK_MODE=weekdays

# Nộp trước giờ này được +3 XP đúng hạn
ON_TIME_HOUR=22

# Nhịp đổi màu role cấp bậc, tính bằng giây. 0 = tắt, màu đứng yên.
# Discord chỉ cho gradient/lấp lánh thật khi server đã boost, nên đây là cách thay thế.
SHIMMER_SECONDS=45

# Số ký tự tối thiểu cho phần "đã làm" — chặn kiểu báo cáo "hôm nay có làm"
MIN_DONE_LENGTH=40

# Đổi vị trí file SQLite (khi deploy nên trỏ vào volume, vd /data/bot.db)
# DB_PATH=
